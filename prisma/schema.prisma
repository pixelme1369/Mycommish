// mycommish — ADP agent commission portal (rebuild)
// See README.md for product invariants (source filters, lock-after-pay, ledger).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth / scoping ───────────────────────────────────────────────────────────

enum EmploymentType {
  employee
  contractor
}

/// Portal login role (separate from employee vs 1099 contractor).
enum AgentRole {
  admin
  /// Same console as admin, plus every manager (and agent) capability.
  super_admin
  manager
  agent
  /// Separate opener comp plan — not included in ADP agent commission.
  opener
}

model Agent {
  id             String         @id @default(cuid())
  email          String         @unique
  passwordHash   String?
  displayName    String
  role           AgentRole      @default(agent)
  /// Derived convenience for gates: true when role is admin or super_admin.
  isAdmin        Boolean        @default(false)
  /// Employees vs 1099 contractors — commission sheet / Excel export differs later.
  employmentType EmploymentType @default(employee)
  /// Legal entity for contractors (shown small on profile; used on contractor sheets).
  companyName    String?
  /// Gusto payroll legal name + employee id (used on Gusto employee export).
  gustoFirstName   String?
  gustoLastName    String?
  gustoEmployeeId  String?
  /// Agent mobile (self-serve from portal; admin can edit on Users).
  phone            String?
  lastLoginAt    DateTime?
  /// When set, portal login is blocked (separate from SalesRepDismissal).
  suspendedAt    DateTime?
  suspendedById  String?
  createdAt      DateTime       @default(now())

  suspendedBy    Agent?  @relation("AgentSuspender", fields: [suspendedById], references: [id], onDelete: SetNull)
  suspendedAgents Agent[] @relation("AgentSuspender")
  aliases AgentAlias[]
  uploads UploadBatch[]
  fileClaims FileClaim[]
  reviewedClaims FileClaim[] @relation("FileClaimReviewer")
  agentSignedStatements CommissionStatement[] @relation("StatementAgentSigner")
  managerSignedStatements CommissionStatement[] @relation("StatementManagerSigner")
  bonusesPaid           ManagerBonusPayout[] @relation("ManagerBonusPaidBy")
  bonusesReceived       ManagerBonusPayout[] @relation("ManagerBonusRecipient")
  bonusesReimbursed     ManagerBonusPayout[] @relation("ManagerBonusReimbursedBy")
  manualBonusesCreated  ManualBonus[]        @relation("ManualBonusCreatedBy")
  manualBonusesApproved ManualBonus[]        @relation("ManualBonusApprovedBy")
  advancesCreated       CommissionAdvance[]  @relation("AdvanceCreatedBy")
  advancesReceived      CommissionAdvance[]  @relation("AdvanceAgent")
  periodExclusionsCreated PeriodAgentExclusion[] @relation("PeriodExclusionCreatedBy")
  teamLeads             TeamLead[]
  dailyTaskCompletions  DailyTaskCompletion[]
  monthlyGoals          AgentMonthlyGoal[]
  forthContacts         ForthContact[]
  documentsCreated      AgentDocument[]            @relation("DocumentCreatedBy")
  documentSignatures    AgentDocumentSignature[]   @relation("DocumentSigner")

  @@index([suspendedAt])
  @@index([lastLoginAt])
}

/// Agent-set monthly production goal (units + annual premium $). Not commission.
model AgentMonthlyGoal {
  id         String   @id @default(cuid())
  agentId    String
  /// Pacific calendar month YYYY-MM.
  monthLabel String
  unitsGoal  Int
  debtGoal   Decimal  @db.Decimal(14, 2)
  /// Expected share of enrolled files that clear into commission (70 = 70%).
  clearRatePct Decimal @default(70) @db.Decimal(5, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, monthLabel])
  @@index([monthLabel])
}

/// Singleton (id = "default"). Admin-set Goals paycheck assumptions for every agent.
model PortalGoalSettings {
  id           String   @id
  clearRatePct Decimal  @default(70) @db.Decimal(5, 2)
  updatedAt    DateTime @updatedAt
}

enum AgentDocumentSignStatus {
  pending
  signed
}

/// Admin-uploaded PDF sent to every agent to e-sign.
model AgentDocument {
  id          String   @id @default(cuid())
  title       String
  filename    String
  contentType String   @default("application/pdf")
  pdfBytes    Bytes
  createdById String
  sentAt      DateTime @default(now())
  createdAt   DateTime @default(now())
  /// Admin filed a physically signed copy — no portal e-sign, kept as a record.
  filedRecord Boolean  @default(false)

  createdBy  Agent                     @relation("DocumentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  signatures AgentDocumentSignature[]

  @@index([sentAt])
}

model AgentDocumentSignature {
  id           String                   @id @default(cuid())
  documentId   String
  agentId      String
  status       AgentDocumentSignStatus  @default(pending)
  typedName    String?
  signaturePng Bytes?
  signedAt     DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  document AgentDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  agent    Agent         @relation("DocumentSigner", fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([documentId, agentId])
  @@index([agentId, status])
  @@index([signedAt])
}

/// Forth CRM contact synced for the goal odometer. Not ClientIdentity.
/// SSN / DOB are never stored. Naive Forth stamps are Pacific.
model ForthContact {
  id              String    @id @default(cuid())
  forthId         String    @unique
  agentId         String?
  clientFirstName String?
  clientLastName  String?
  status          String?
  enrolledAmount  Decimal   @default(0) @db.Decimal(14, 2)
  /// Cordoba enrolled / enrolled_date. Date-only values are midnight Pacific.
  enrolledDate    DateTime?
  /// Forth submitted_at. Naive stamps are Pacific.
  submittedDate   DateTime?
  assignedTo      String?
  tpId            String?
  stageTitle      String?
  contactType     String?
  leadStatusId    String?
  timeInStatus    String?
  inactiveDays    Int?
  campaignId      String?
  lastCreditPulledDate DateTime?
  /// Cordoba Dropped Date (c772034).
  droppedDate     DateTime?
  source          String?
  state           String?
  /// Forth program_start_date.
  programStartDate DateTime?
  /// Forth `created`. Naive stamps are Pacific.
  forthCreatedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  agent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([agentId, submittedDate])
  @@index([agentId, enrolledDate])
  @@index([submittedDate])
  @@index([enrolledDate])
}

model AgentAlias {
  id        String @id @default(cuid())
  agentId   String
  agentName String @unique // exact CRM "Sales Rep" spelling

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

enum FileClaimStatus {
  pending
  accepted
  rejected
}

/// Agent reports a CRM file (client) missing from their book; admin reviews.
model FileClaim {
  id           String          @id @default(cuid())
  agentId      String
  /// External ID (or CRM ID) the agent claimed with.
  crmId        String
  clientName   String
  note         String?
  status       FileClaimStatus @default(pending)
  adminNote    String?
  /// Sales Rep spelling locked on accept — CRM re-uploads keep this assignment.
  assignedSalesRep String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  agent      Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  reviewedBy Agent? @relation("FileClaimReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([agentId, status])
  @@index([status, createdAt])
  @@index([crmId])
}

/// Day-1 / day-5 follow-up checklist (Email, SMS, Call) for portal Daily Tasks.
enum DailyFollowUpDay {
  day1
  day5
}

model DailyTaskCompletion {
  id          String           @id @default(cuid())
  agentId     String
  crmId       String
  followUp    DailyFollowUpDay
  /// Enrollment calendar day as YYYY-MM-DD (from CRM Enrolled Date parse).
  enrolledYmd String
  emailDone   Boolean          @default(false)
  smsDone     Boolean          @default(false)
  callDone    Boolean          @default(false)
  emailDoneAt DateTime?
  smsDoneAt   DateTime?
  callDoneAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  agent    Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  identity ClientIdentity @relation(fields: [crmId], references: [crmId], onDelete: Cascade)

  @@unique([agentId, crmId, followUp, enrolledYmd])
  @@index([agentId, followUp])
  @@index([crmId])
}

enum ManagerBonusStatus {
  owed
  reimbursed
}

/// Manager paid an agent bonus from their own account; company reimburses on commission pay date.
model ManagerBonusPayout {
  id               String             @id @default(cuid())
  paidById         String
  /// Linked portal user when chosen from the dropdown; null if typed freehand.
  recipientAgentId String?
  /// Display name at log time (always set — dropdown or typed).
  recipientName    String
  amount           Decimal            @db.Decimal(12, 2)
  reason           String
  paidOn           DateTime
  /// Commission month (YYYY-MM) whose pay date (25th next month) reimburses this.
  periodLabel      String
  status           ManagerBonusStatus @default(owed)
  reimbursedAt     DateTime?
  reimbursedById   String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  paidBy         Agent  @relation("ManagerBonusPaidBy", fields: [paidById], references: [id], onDelete: Cascade)
  recipientAgent Agent? @relation("ManagerBonusRecipient", fields: [recipientAgentId], references: [id], onDelete: SetNull)
  reimbursedBy   Agent? @relation("ManagerBonusReimbursedBy", fields: [reimbursedById], references: [id], onDelete: SetNull)

  @@index([paidById, status])
  @@index([periodLabel, status])
  @@index([recipientAgentId])
}

enum ManualBonusStatus {
  pending
  approved
}

/// Manager-entered discretionary bonus on an agent’s period. Counts in net only after super-admin approval.
model ManualBonus {
  id            String            @id @default(cuid())
  /// Durable keys — survive period delete / CRM re-upload (like CommissionStatement).
  periodLabel   String
  agentName     String
  agentPeriodId String?
  amount        Decimal           @db.Decimal(12, 2)
  note          String
  status        ManualBonusStatus @default(pending)
  createdById   String
  approvedById  String?
  approvedAt    DateTime?
  /// Ledger row written on approve (type manual_bonus); cleared if period/ledger wiped.
  ledgerEntryId String?           @unique
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  agentPeriod AgentPeriod? @relation(fields: [agentPeriodId], references: [id], onDelete: SetNull)
  createdBy   Agent        @relation("ManualBonusCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  approvedBy  Agent?       @relation("ManualBonusApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  ledgerEntry LedgerEntry? @relation(fields: [ledgerEntryId], references: [id], onDelete: SetNull)

  @@index([agentPeriodId, status])
  @@index([periodLabel, agentName])
  @@index([status, createdAt])
  @@index([createdById])
}

/// Company advance: add $ to one period's paycheck, deduct from a later period.
/// Durable across CRM wipe (keyed by period labels + agentName).
model CommissionAdvance {
  id                    String    @id @default(cuid())
  /// CRM Sales Rep spelling (matches AgentPeriod.agentName).
  agentName             String
  /// Portal user when chosen from the directory; optional.
  agentId               String?
  amount                Decimal   @db.Decimal(12, 2)
  note                  String?
  /// Period whose payday includes the advance (e.g. July paid Aug 25).
  payWithPeriodLabel    String
  /// Period we recover from (e.g. August).
  deductFromPeriodLabel String
  createdById           String
  cancelledAt           DateTime?
  payAgentPeriodId      String?
  repayAgentPeriodId    String?
  payLedgerEntryId      String?   @unique
  repayLedgerEntryId    String?   @unique
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  createdBy      Agent            @relation("AdvanceCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  agent          Agent?           @relation("AdvanceAgent", fields: [agentId], references: [id], onDelete: SetNull)
  payAgentPeriod AgentPeriod?     @relation("AdvancePayPeriod", fields: [payAgentPeriodId], references: [id], onDelete: SetNull)
  repayAgentPeriod AgentPeriod?   @relation("AdvanceRepayPeriod", fields: [repayAgentPeriodId], references: [id], onDelete: SetNull)
  payLedgerEntry LedgerEntry?     @relation("AdvancePayLedger", fields: [payLedgerEntryId], references: [id], onDelete: SetNull)
  repayLedgerEntry LedgerEntry?   @relation("AdvanceRepayLedger", fields: [repayLedgerEntryId], references: [id], onDelete: SetNull)

  @@index([agentName])
  @@index([payWithPeriodLabel])
  @@index([deductFromPeriodLabel])
  @@index([createdById])
  @@index([cancelledAt])
}

/// Soft-dismiss a CRM Sales Rep from active commission views / Gusto.
/// Ledger + AgentPeriod rows stay for audit; UI and payroll export hide them.
model SalesRepDismissal {
  id           String   @id @default(cuid())
  agentNameKey String   @unique // lowercase CRM spelling
  agentName    String
  dismissedAt  DateTime @default(now())
  note         String?
  createdAt    DateTime @default(now())
}

/// Hide an agent from one calculated period’s pay list / Gusto only.
/// Durable across CRM wipe (keyed by periodLabel + agentNameKey).
model PeriodAgentExclusion {
  id           String   @id @default(cuid())
  periodLabel  String // YYYY-MM
  agentNameKey String
  agentName    String
  note         String?
  createdById  String?
  createdAt    DateTime @default(now())

  createdBy Agent? @relation("PeriodExclusionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([periodLabel, agentNameKey])
  @@index([periodLabel])
  @@index([agentNameKey])
}

/// How a team-lead bonus counts units for a period.
enum TeamLeadBonusScope {
  /// Sum of selected teammates’ unitsCleared.
  roster
  /// Sum of every agent’s unitsCleared on the period (period “Units cleared” total).
  all_period_units
}

/// Portal agent who earns a per-unit bonus on teammates’ cleared files.
model TeamLead {
  id            String             @id @default(cuid())
  leadAgentId   String
  /// CRM Sales Rep spelling for the AgentPeriod / ledger row that receives the bonus.
  leadAgentName String
  ratePerUnit   Decimal            @default(5) @db.Decimal(8, 2)
  bonusScope    TeamLeadBonusScope @default(roster)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  leadAgent Agent        @relation(fields: [leadAgentId], references: [id], onDelete: Cascade)
  members   TeamMember[]

  @@unique([leadAgentId])
  @@index([leadAgentName])
}

model TeamMember {
  id                 String @id @default(cuid())
  teamLeadId         String
  memberAgentName    String
  memberAgentNameKey String
  createdAt          DateTime @default(now())

  teamLead TeamLead @relation(fields: [teamLeadId], references: [id], onDelete: Cascade)

  @@unique([teamLeadId, memberAgentNameKey])
  @@index([memberAgentNameKey])
}

// ─── Periods ──────────────────────────────────────────────────────────────────

enum PeriodSource {
  calculated // live CRM / Cordoba holding — what agents are owed
  history // backfilled account-manager ledger — audit / anti-double-pay only
}

enum PeriodStatus {
  open // CRM recompute may refresh units/gross
  closed // past payday (25th of next month): no unit/gross rewrite; clawbacks still allowed
}

model CommissionPeriod {
  id          String       @id @default(cuid())
  periodLabel String // YYYY-MM
  source      PeriodSource
  status      PeriodStatus @default(open)
  filename    String?
  uploadedAt  DateTime     @default(now())
  closedAt    DateTime?

  agentPeriods AgentPeriod[]
  clientEvents ClientEvent[]
  ledgerEntries LedgerEntry[]

  @@unique([periodLabel, source])
  @@index([periodLabel])
  @@index([source, periodLabel])
}

model AgentPeriod {
  id       String @id @default(cuid())
  periodId String
  agentName String

  // Cached rollup of non-reversed LedgerEntry rows (+ classification stats).
  // Ledger is authoritative for money; recompute on every ledger write.
  unitsCleared             Int     @default(0)
  totalClearedDebt         Decimal @default(0) @db.Decimal(14, 2)
  cancellationRate         Decimal @default(0) @db.Decimal(8, 4)
  rawTier                 Int     @default(0)
  adjustedTier             Int     @default(0)
  tierRate                 Decimal @default(0) @db.Decimal(8, 6)
  grossCommission          Decimal @default(0) @db.Decimal(14, 2)
  clawbackAmount           Decimal @default(0) @db.Decimal(14, 2)
  /// Sum of approved manual bonuses (ledger type manual_bonus).
  manualBonusAmount        Decimal @default(0) @db.Decimal(14, 2)
  /// Team-lead per-unit bonus from teammate clears (ledger team_lead_bonus).
  teamLeadBonusAmount      Decimal @default(0) @db.Decimal(14, 2)
  /// Advances paid out on this period's paycheck (ledger advance_paid).
  advancePaidAmount        Decimal @default(0) @db.Decimal(14, 2)
  /// Advances recovered on this period (ledger advance_repay).
  advanceRepayAmount       Decimal @default(0) @db.Decimal(14, 2)
  netCommission            Decimal @default(0) @db.Decimal(14, 2)
  payout                   Decimal @default(0) @db.Decimal(14, 2)
  payoutType               String  @default("commission")
  qualityBonusEligible     Boolean @default(false)
  cancellationPenaltyApplied Boolean @default(false)
  nsfFlagged               Boolean @default(false)
  pendingUnits             Int     @default(0)
  pendingDebt              Decimal @default(0) @db.Decimal(14, 2)
  notes                    String?

  period        CommissionPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  clientEvents  ClientEvent[]
  ledgerEntries LedgerEntry[]
  statement     CommissionStatement?
  manualBonuses ManualBonus[]
  advancesPaid  CommissionAdvance[] @relation("AdvancePayPeriod")
  advancesRepaid CommissionAdvance[] @relation("AdvanceRepayPeriod")

  @@unique([periodId, agentName])
  @@index([agentName])
}

/// E-signed commission statement: agent signs first, then manager/admin.
enum StatementSignStatus {
  unsigned
  agent_signed
  fully_signed
}

model CommissionStatement {
  id String @id @default(cuid())
  /// Durable keys — survive commission period delete / CRM re-upload.
  periodLabel String
  agentName   String
  /// Live link when the calculated AgentPeriod exists; null while period is deleted.
  agentPeriodId String? @unique
  status        StatementSignStatus @default(unsigned)

  agentTypedName      String?
  agentSignaturePng   Bytes?
  agentSignedAt       DateTime?
  agentSignedById     String?
  netAtAgentSign      Decimal?  @db.Decimal(14, 2)

  managerTypedName    String?
  managerSignaturePng Bytes?
  managerSignedAt     DateTime?
  managerSignedById   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentPeriod   AgentPeriod? @relation(fields: [agentPeriodId], references: [id], onDelete: SetNull)
  agentSigner   Agent?       @relation("StatementAgentSigner", fields: [agentSignedById], references: [id], onDelete: SetNull)
  managerSigner Agent?       @relation("StatementManagerSigner", fields: [managerSignedById], references: [id], onDelete: SetNull)

  @@unique([periodLabel, agentName])
  @@index([status])
  @@index([periodLabel, status])
}

// ─── Clients ──────────────────────────────────────────────────────────────────

model ClientIdentity {
  /// ADP CRM "ID" column — internal ledger / event key (not what agents see).
  crmId        String   @id
  /// ADP CRM "External ID" === Cordoba file "ID". Agents search/claim with this only.
  externalId   String?
  /// Last known CRM Sales Rep (for assignment checks even when not commissionable yet).
  salesRep     String?
  clientName   String?
  email        String?
  phone        String?
  enrolledDebt Decimal? @db.Decimal(14, 2)
  creditScore  Int?
  payFreq      String?
  /// CRM Status string when last seen (e.g. Pending Affiliate Cancellation).
  crmStatus    String?
  enrolledDate String?
  /// CRM "1st Payment Date" (scheduled) — used for Waiting For First Payment watchlist.
  firstPaymentDate String?
  firstPaymentClearedDate String?
  /// CRM "2nd Payment Cleared Date" — monthly files need this to pass last-check threshold.
  secondPaymentClearedDate String?
  /// Latest CRM "Payments Made" (directory). Used for last-check threshold.
  paymentsMade Int?
  droppedDate  String?
  updatedAt    DateTime @updatedAt

  events        ClientEvent[]
  ledgerEntries LedgerEntry[]
  cordobaPaid   CordobaPaid?
  chargebackSeen CordobaChargebackSeen?
  chargebackSnapshot CordobaChargebackSnapshot?
  dailyTaskCompletions DailyTaskCompletion[]

  @@index([externalId])
  @@index([clientName])
  @@index([salesRep])
}

enum ClientEventKind {
  cleared
  pending
  safe_cancel
  same_month_cancel
  clawback
  cordoba_clawback
  history_paid
  history_subtract
  low_credit_cleared
}

model ClientEvent {
  id            String         @id @default(cuid())
  crmId         String
  periodId      String
  agentPeriodId String?
  agentName     String
  kind          ClientEventKind

  clientName               String?
  enrolledDate             String?
  firstPaymentClearedDate  String?
  secondPaymentClearedDate String?
  droppedDate              String?
  payFreq                  String?
  paymentsMade             Int     @default(0)
  enrolledDebt             Decimal @default(0) @db.Decimal(14, 2)
  creditScore              Int?
  isLowCredit              Boolean @default(false)
  isCleared                Boolean @default(false) // was paid commission
  clawbackApplied          Boolean @default(false)
  commissionOnClient       Decimal @default(0) @db.Decimal(14, 2)
  clawbackAmount           Decimal @default(0) @db.Decimal(14, 2)
  paidRate                 Decimal? @db.Decimal(8, 6) // history Rate, or super-admin override for clawbacks
  isLateActivation         Boolean @default(false)
  originalClearedPeriod    String?
  uploadBatchId            String?

  identity    ClientIdentity    @relation(fields: [crmId], references: [crmId])
  period      CommissionPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  agentPeriod AgentPeriod?      @relation(fields: [agentPeriodId], references: [id], onDelete: SetNull)
  uploadBatch UploadBatch?      @relation(fields: [uploadBatchId], references: [id], onDelete: SetNull)

  @@index([crmId])
  @@index([periodId])
  @@index([agentPeriodId])
  @@index([crmId, isCleared])
  @@index([crmId, droppedDate])
}

// ─── Ledger (authoritative money) ─────────────────────────────────────────────

enum LedgerType {
  commission_credit
  clawback_crm
  clawback_cordoba
  clawback_history
  /// Super-admin–approved manager manual bonus (added into net).
  manual_bonus
  /// Team-lead bonus: rate × teammate cleared units (added into net).
  team_lead_bonus
  /// Company advance included on this period's paycheck.
  advance_paid
  /// Company advance recovered from this period's paycheck.
  advance_repay
  reversal
}

model LedgerEntry {
  id              String     @id @default(cuid())
  type            LedgerType
  amount          Decimal    @db.Decimal(14, 2) // signed: credits +, clawbacks typically stored positive and applied as deductions
  crmId           String?
  agentName       String
  periodId        String
  agentPeriodId   String?
  reasonCode      String?
  note            String?
  uploadBatchId   String?
  reversesEntryId String?    @unique // if set, this row undoes another
  createdAt       DateTime   @default(now())

  identity      ClientIdentity?   @relation(fields: [crmId], references: [crmId])
  period        CommissionPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  agentPeriod   AgentPeriod?      @relation(fields: [agentPeriodId], references: [id], onDelete: SetNull)
  uploadBatch   UploadBatch?      @relation(fields: [uploadBatchId], references: [id], onDelete: SetNull)
  reversesEntry LedgerEntry?      @relation("LedgerReversal", fields: [reversesEntryId], references: [id])
  reversedBy    LedgerEntry?      @relation("LedgerReversal")
  manualBonus   ManualBonus?
  advancePay    CommissionAdvance? @relation("AdvancePayLedger")
  advanceRepay  CommissionAdvance? @relation("AdvanceRepayLedger")

  @@index([periodId, agentName])
  @@index([crmId])
  @@index([uploadBatchId])
  @@index([type])
}

// ─── Cordoba display ledgers ──────────────────────────────────────────────────

model CordobaPaid {
  crmId             String   @id
  clientName        String?
  source            String? // first_pays | epf
  uploadedFilename  String?
  uploadedAt        DateTime @default(now())

  identity ClientIdentity @relation(fields: [crmId], references: [crmId])
}

model CordobaChargebackSeen {
  crmId            String   @id
  clientName        String?
  uploadedFilename  String?
  uploadedAt        DateTime @default(now())

  identity ClientIdentity @relation(fields: [crmId], references: [crmId])
}

model CordobaChargebackSnapshot {
  crmId                      String   @id
  agentName                  String
  periodLabel                String // from OUR dropped_date
  assignedCompany            String?
  enrolledDate               String?
  clientName                 String?
  status                     String?
  marketingPayoutDebt        Decimal? @db.Decimal(14, 2)
  firstPaymentClearedDate    String?
  payFreq                    String?
  paymentsMade               Int?
  marketingPaymentCleared    String?
  marketingPaymentChargeback String?
  fileDroppedDate            String?
  uploadedFilename           String?
  uploadedAt                 DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  identity ClientIdentity @relation(fields: [crmId], references: [crmId])

  @@index([agentName, periodLabel])
}

// ─── Upload audit ─────────────────────────────────────────────────────────────

enum UploadType {
  crm
  cordoba
  history
}

model UploadBatch {
  id           String     @id @default(cuid())
  type         UploadType
  filename     String
  uploadedById String?
  summaryJson  Json? // counts + skip tallies (inspectable, not flash-only)
  createdAt    DateTime   @default(now())

  uploadedBy    Agent?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  clientEvents  ClientEvent[]
  ledgerEntries LedgerEntry[]

  @@index([type, createdAt])
}
