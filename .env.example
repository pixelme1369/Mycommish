# PostgreSQL (Neon). uselibpqcompat avoids a pg driver SSL warning.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&uselibpqcompat=true"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Optional Google (not required — password login via Agent.passwordHash)
# AUTH_GOOGLE_ID="your-google-oauth-client-id"
# AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

