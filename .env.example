# PostgreSQL (Neon). uselibpqcompat avoids a pg driver SSL warning.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&uselibpqcompat=true"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Google OAuth (optional — leave unset to hide "Continue with Google")
# Redirect URI: {AUTH_URL}/api/auth/callback/google
# AUTH_GOOGLE_ID="your-google-oauth-client-id"
# AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# Forth CRM (goal odometer). Never commit real values.
# FORTH_API_KEY=""
# FORTH_LIST_ID=""
# Optional second list if enrolled files live separately:
# FORTH_ENROLLED_LIST_ID=""
# FORTH_API_BASE="https://api.forthcrm.com/v1"
# CRON_SECRET=""

